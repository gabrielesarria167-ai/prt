# Carrozzeria PRT – Apache config for Aruba hosting

# Serve the static site's home page instead of Aruba's placeholder index.php
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.carrozzeriaprt.it/$1 [R=301,L]

# Use www.carrozzeriaprt.it as the single canonical host
RewriteCond %{HTTP_HOST} ^carrozzeriaprt\.it$ [NC]
RewriteRule ^(.*)$ https://www.carrozzeriaprt.it/$1 [R=301,L]

# Hide leftover placeholder/server files
RewriteRule ^(index\.php|ver\.php|sito-prt\.zip)$ - [R=404,L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  # CSS/JS are cache-busted with ?v=<hash> by build.py
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>
